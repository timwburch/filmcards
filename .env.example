# Neon pooled connection string (Dashboard -> Connection Details -> Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Resend API key and a verified sender on your domain
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Film Cards <noreply@yourdomain.com>"

# Where approval requests are sent — the repo owner
OWNER_EMAIL="you@yourdomain.com"

# Public origin serving /api (no trailing slash)
API_BASE_URL="https://filmcards.vercel.app"

# Public origin serving index.html — same as API_BASE_URL unless the page
# lives on GitHub Pages, e.g. https://timburch.github.io/filmcards
SITE_URL="https://filmcards.vercel.app"

# Comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS="https://filmcards.vercel.app,http://localhost:3000"
